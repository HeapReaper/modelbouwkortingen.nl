# ── Database ─────────────────────────────────────────────
# Lokaal ontwikkelen: wijs naar je eigen Postgres. Zonder DATABASE_URL draait de
# website in demo-modus met voorbeelddata.
DATABASE_URL=postgres://modelbouwkortingen:wachtwoord@localhost:5432/modelbouwkortingen?sslmode=disable
# Alleen voor docker-compose (in Coolify worden deze automatisch gegenereerd):
SERVICE_USER_POSTGRES=modelbouwkortingen
SERVICE_PASSWORD_POSTGRES=verander-mij
SERVICE_PASSWORD_64_CRAWLERSTATS=verander-mij-ook

# ── Website ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://modelbouwkortingen.nl
# Admin panel op /admin (Basic Auth). Leeg = admin uitgeschakeld.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optioneel: token voor /api/stats ("Authorization: Bearer <token>") voor monitoring.
STATS_TOKEN=
# Waar de website de live stats van de crawler ophaalt.
CRAWLER_STATS_URL=http://localhost:8080/stats

# ── Dagelijkse kortingsmail ──────────────────────────────
# Elke SMTP-provider werkt (Brevo, Mailgun, Postmark, Amazon SES, eigen server, ...).
# Zonder SMTP_HOST/MAIL_FROM kan men zich wel aanmelden, maar gaat er geen mail uit
# (de bevestigingslink verschijnt dan in de serverlog).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leeg = automatisch (TLS op poort 465, STARTTLS op 587/25).
SMTP_SECURE=
MAIL_FROM="Modelbouwkortingen.nl <deals@modelbouwkortingen.nl>"
# Vanaf welk uur (Nederlandse tijd) de dagelijkse mail verstuurd wordt.
NEWSLETTER_SEND_HOUR=8
# "off" = geen ingebouwde planner (bv. als je zelf een cron op
# POST /api/nieuwsbrief/verzenden zet; dan is NEWSLETTER_CRON_TOKEN verplicht).
NEWSLETTER_SCHEDULER=
NEWSLETTER_CRON_TOKEN=
# (De planner post ook nieuwe deals naar Discord-webhooks; daar is geen instelling voor nodig.
# Alleen voor lokaal testen met een nep-Discord: DISCORD_API_ORIGIN=http://127.0.0.1:2626)

# ── Vertalen ─────────────────────────────────────────────
# Productnamen van Duitstalige webshops worden via Amazon Translate vertaald naar het
# Nederlands en Engels. Gebruik een IAM-gebruiker met alleen "translate:TranslateText".
# Leeg = geen nieuwe vertalingen; de site toont dan de Duitse namen.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# ── Crawler ──────────────────────────────────────────────
# Optioneel: beveilig de /stats endpoint van de crawler.
CRAWLER_STATS_TOKEN=
CRAWLER_INTERVAL=6h
CRAWLER_WORKERS_PER_SHOP=4
CRAWLER_HOST_DELAY=500ms
CRAWLER_MAX_PRODUCT_PAGES=4000
MIN_DISCOUNT_EUR=5
MIN_DISCOUNT_PERCENT=5
