# ── Database ─────────────────────────────────────────────
# Lokaal ontwikkelen: wijs naar je eigen Postgres. Zonder DATABASE_URL draait de
# website in demo-modus met voorbeelddata.
DATABASE_URL=postgres://modelbouwkortingen:wachtwoord@localhost:5432/modelbouwkortingen?sslmode=disable
# Alleen voor docker-compose (in Coolify worden deze automatisch gegenereerd):
SERVICE_USER_POSTGRES=modelbouwkortingen
SERVICE_PASSWORD_POSTGRES=verander-mij
SERVICE_PASSWORD_64_CRAWLERSTATS=verander-mij-ook

# ── Website ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://modelbouwkortingen.nl
# Admin panel op /admin (Basic Auth). Leeg = admin uitgeschakeld.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optioneel: token voor /api/stats ("Authorization: Bearer <token>") voor monitoring.
STATS_TOKEN=
# Waar de website de live stats van de crawler ophaalt.
CRAWLER_STATS_URL=http://localhost:8080/stats

# ── Crawler ──────────────────────────────────────────────
# Optioneel: beveilig de /stats endpoint van de crawler.
CRAWLER_STATS_TOKEN=
CRAWLER_INTERVAL=6h
CRAWLER_WORKERS_PER_SHOP=4
CRAWLER_HOST_DELAY=500ms
CRAWLER_MAX_PRODUCT_PAGES=4000
MIN_DISCOUNT_EUR=5
MIN_DISCOUNT_PERCENT=5
