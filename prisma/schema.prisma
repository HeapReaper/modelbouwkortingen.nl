// Modelbouwkortingen.nl database schema.
// Gedeeld door de Go crawler (schrijft) en de Next.js website (leest + contactformulier).
// Migraties: `npx prisma migrate dev` (lokaal) / `npx prisma migrate deploy` (productie).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model Shop {
  id               Int                  @id @default(autoincrement())
  slug             String               @unique
  name             String
  baseUrl          String               @map("base_url")
  description      String               @default("")
  enabled          Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  products         Product[]
  crawlRuns        CrawlRun[]
  crawlMisses      CrawlMiss[]
  clicks           OutboundClick[]
  promotions       Promotion[]
  hiddenCategories ShopHiddenCategory[]

  @@map("shops")
}

model Category {
  slug      String               @id
  name      String
  sortOrder Int                  @default(0) @map("sort_order")
  products  Product[]
  hiddenAt  ShopHiddenCategory[]

  @@map("categories")
}

/// Categorie die bij deze webshop niet op de site staat (adminpanel). Zie Product.hidden.
model ShopHiddenCategory {
  shopId       Int      @map("shop_id")
  categorySlug String   @map("category_slug")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@id([shopId, categorySlug])
  @@map("shop_hidden_categories")
}

model Product {
  id              BigInt               @id @default(autoincrement())
  shopId          Int                  @map("shop_id")
  externalId      String               @map("external_id")
  url             String
  sku             String?
  /// Artikelnummer in hoofdletters zonder spaties/streepjes (zie normalizeSku() in src/lib/compare.ts),
  /// NULL als het te kort is of geen cijfer bevat. Door Postgres berekend (GENERATED ALWAYS ... STORED,
  /// zie migratie 20261018000000_features): nooit zelf schrijven.
  skuNorm         String?              @map("sku_norm")
  name            String
  brand           String?
  /// Naam + merk + actuele vertalingen in kleine letters, alleen a-z en 0-9 (zie searchNorm() in
  /// src/lib/deals.ts). Door Postgres berekend via triggers op products en product_translations
  /// (migraties 20261019220000_search_norm en 20261028200000_search_norm_index): nooit zelf schrijven.
  searchNorm      String?              @map("search_norm")
  imageUrl        String?              @map("image_url")
  categorySlug    String               @default("overig") @map("category_slug")
  shopCategory    String?              @map("shop_category")
  /// true = de categorie is bij deze shop verborgen (shop_hidden_categories); dan staat het product
  /// nergens op de site. Door Postgres bijgehouden via triggers (migratie
  /// 20261023120000_shop_hidden_categories): nooit zelf schrijven.
  hidden          Boolean              @default(false)
  price           Decimal              @db.Decimal(10, 2)
  /// "Van"-prijs zoals de webshop die toont (doorgestreept), of NULL.
  oldPrice        Decimal?             @map("old_price") @db.Decimal(10, 2)
  /// Referentieprijs waartegen de korting berekend wordt: de hoogste prijs die we zelf
  /// sinds baseline_since (max. 30 dagen terug) zagen; blijft vast zolang de deal loopt.
  referencePrice  Decimal?             @map("reference_price") @db.Decimal(10, 2)
  discountAmount  Decimal              @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercent Decimal              @default(0) @map("discount_percent") @db.Decimal(5, 2)
  isDeal          Boolean              @default(false) @map("is_deal")
  inStock         Boolean?             @map("in_stock")
  dealSince       DateTime?            @map("deal_since") @db.Timestamptz
  /// Nulmeting: prijshistorie van vóór dit moment telt niet mee voor de referentieprijs
  /// (gezet wanneer de prijs na een deal weer stijgt). NULL = alle historie.
  baselineSince   DateTime?            @map("baseline_since") @db.Timestamptz
  firstSeenAt     DateTime             @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt      DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz
  lastCrawledAt   DateTime?            @map("last_crawled_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz
  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category        Category             @relation(fields: [categorySlug], references: [slug])
  priceHistory    PriceHistory[]
  priceAlerts     PriceAlert[]
  clicks          OutboundClick[]
  translations    ProductTranslation[]
  promotions      Promotion[]
  watchlistItems  WatchlistItem[]

  @@unique([shopId, externalId])
  @@index([isDeal, discountPercent(sort: Desc)], map: "products_deals_idx", where: raw("is_deal"))
  @@index([dealSince(sort: Desc)], map: "products_deal_since_idx", where: raw("is_deal"))
  @@index([shopId, isDeal], map: "products_shop_idx")
  @@index([categorySlug, isDeal], map: "products_category_idx")
  @@index([shopId, lastCrawledAt], map: "products_crawled_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@index([brand(ops: raw("gin_trgm_ops"))], map: "products_brand_trgm_idx", type: Gin)
  /// Voor de prijsvergelijker: zoeken op (een deel van) het artikelnummer.
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "products_sku_trgm_idx", type: Gin)
  /// Zoeken (termWhere in src/lib/deals.ts): samen met de sku-index de hele zoekterm.
  @@index([searchNorm(ops: raw("gin_trgm_ops"))], map: "products_search_norm_trgm_idx", type: Gin)
  /// "Ook verkrijgbaar bij": hetzelfde artikelnummer bij andere webshops.
  @@index([skuNorm], map: "products_sku_norm_idx")
  @@index([brand], map: "products_brand_idx")
  @@map("products")
}

model PriceHistory {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt   @map("product_id")
  price      Decimal  @db.Decimal(10, 2)
  oldPrice   Decimal? @map("old_price") @db.Decimal(10, 2)
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, observedAt(sort: Desc)], map: "price_history_product_idx")
  @@map("price_history")
}

model CrawlRun {
  id           BigInt      @id @default(autoincrement())
  shopId       Int         @map("shop_id")
  startedAt    DateTime    @default(now()) @map("started_at") @db.Timestamptz
  finishedAt   DateTime?   @map("finished_at") @db.Timestamptz
  /// running | ok | failed | aborted
  status       String      @default("running")
  pagesFetched Int         @default(0) @map("pages_fetched")
  productsSeen Int         @default(0) @map("products_seen")
  dealsFound   Int         @default(0) @map("deals_found")
  errors       Int         @default(0)
  rateLimited  Int         @default(0) @map("rate_limited")
  message      String?
  shop         Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  alert        CrawlAlert?

  @@index([shopId, startedAt(sort: Desc)], map: "crawl_runs_shop_idx")
  @@map("crawl_runs")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_messages")
}

/// Aanmelding voor de dagelijkse kortingsmail (double opt-in).
model NewsletterSubscriber {
  id                 BigInt    @id @default(autoincrement())
  /// Altijd in kleine letters opgeslagen.
  email              String    @unique
  /// Geheim token voor de bevestigings- en afmeldlink.
  token              String    @unique
  /// NULL = nog niet bevestigd; zolang krijgt het adres geen kortingsmails.
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz
  unsubscribedAt     DateTime? @map("unsubscribed_at") @db.Timestamptz
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz
  lastSentAt         DateTime? @map("last_sent_at") @db.Timestamptz
  /// Taal van de site bij het aanmelden (nl, en, de); de mails gaan in deze taal.
  locale             String    @default("nl")
  /// Voorkeuren: alleen deals uit deze categorieën / webshops (leeg = alles) en met minstens
  /// zoveel procent korting.
  categories         String[]  @default([])
  shops              String[]  @default([])
  minDiscount        Int       @default(0) @map("min_discount")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([confirmedAt, unsubscribedAt], map: "newsletter_subscribers_active_idx")
  @@map("newsletter_subscribers")
}

/// Eén rij per verzenddag: de primary key voorkomt dat de mail twee keer per dag uitgaat.
model NewsletterRun {
  day        DateTime  @id @db.Date
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  /// running | ok | skipped | failed
  status     String    @default("running")
  deals      Int       @default(0)
  recipients Int       @default(0)
  errors     Int       @default(0)
  message    String?

  @@map("newsletter_runs")
}

/// Discord-webhook die elke nieuwe deal als embed ontvangt.
model DiscordSubscriber {
  id              BigInt    @id @default(autoincrement())
  /// Het id-deel van de webhook-URL; één abonnement per webhook.
  webhookId       String    @unique @map("webhook_id")
  /// Volledige webhook-URL (bevat het geheime webhook-token).
  webhookUrl      String    @map("webhook_url")
  /// Geheim token voor de afmeldlink.
  token           String    @unique
  guildId         String?   @map("guild_id")
  channelId       String?   @map("channel_id")
  name            String?
  /// Tot en met deze deal (deal_since, product-id) is alles gepost.
  cursorAt        DateTime  @default(now()) @map("cursor_at") @db.Timestamptz
  cursorProductId BigInt    @default(0) @map("cursor_product_id")
  lastPostedAt    DateTime? @map("last_posted_at") @db.Timestamptz
  /// Gezet bij afmelden of als Discord de webhook niet meer kent; dan posten we niet meer.
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz
  disabledReason  String?   @map("disabled_reason")
  /// Taal van de site bij het koppelen (nl, en, de); de berichten gaan in deze taal.
  locale          String    @default("nl")
  /// Voorkeuren: alleen deals uit deze categorieën / webshops (leeg = alles) en met minstens
  /// zoveel procent korting.
  categories      String[]  @default([])
  shops           String[]  @default([])
  minDiscount     Int       @default(0) @map("min_discount")
  /// Account dat de webhook koppelde terwijl het ingelogd was; dat account kan de voorkeuren beheren.
  userId          BigInt?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([disabledAt], map: "discord_subscribers_active_idx")
  @@index([userId], map: "discord_subscribers_user_idx")
  @@map("discord_subscribers")
}

/// Prijsalarm: een mail zodra de prijs van een product op of onder de doelprijs komt (double opt-in).
model PriceAlert {
  id             BigInt    @id @default(autoincrement())
  productId      BigInt    @map("product_id")
  /// Altijd in kleine letters opgeslagen.
  email          String
  targetPrice    Decimal   @map("target_price") @db.Decimal(10, 2)
  /// Geheim token voor de bevestigings- en afmeldlink.
  token          String    @unique
  locale         String    @default("nl")
  /// NULL = nog niet bevestigd; zolang sturen we geen alarm.
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz
  /// Gezet zodra het alarm verstuurd is: één mail per alarm.
  triggeredAt    DateTime? @map("triggered_at") @db.Timestamptz
  /// Prijs op het moment van het alarm.
  triggeredPrice Decimal?  @map("triggered_price") @db.Decimal(10, 2)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "price_alerts_product_idx")
  @@index([email], map: "price_alerts_email_idx")
  @@index([confirmedAt], map: "price_alerts_active_idx", where: raw("triggered_at IS NULL AND cancelled_at IS NULL"))
  @@map("price_alerts")
}

/// Vertaalde productnaam voor producten van anderstalige webshops (zie src/lib/translate.ts).
model ProductTranslation {
  productId  BigInt   @map("product_id")
  /// Doeltaal (nl, en, de).
  locale     String
  name       String
  /// De originele naam die vertaald is; wijzigt de naam bij de webshop, dan vertalen we opnieuw.
  sourceName String   @map("source_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  /// Zoeken op de vertaalde naam (zoekbalk in de eigen taal).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "product_translations_name_trgm_idx", type: Gin)
  @@map("product_translations")
}

/// Eén klik op "naar de webshop" (via /api/uit/[id]).
model OutboundClick {
  id        BigInt   @id @default(autoincrement())
  productId BigInt?  @map("product_id")
  shopId    Int      @map("shop_id")
  /// Waar de klik vandaan kwam: site | mail | discord | alarm | feed | featured.
  source    String   @default("site")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "outbound_clicks_created_idx")
  @@index([shopId, createdAt], map: "outbound_clicks_shop_idx")
  @@index([productId, createdAt], map: "outbound_clicks_product_idx")
  @@map("outbound_clicks")
}

/// Waarschuwing dat een crawl-ronde opvallend weinig producten zag (parser kapot?).
/// De primary key op run_id zorgt dat elke ronde hooguit één melding krijgt.
model CrawlAlert {
  runId      BigInt    @id @map("run_id")
  shopId     Int       @map("shop_id")
  /// Producten in deze ronde en het mediaan van de vorige geslaagde rondes.
  seen       Int
  baseline   Int
  /// Gezet zodra de melding naar ALERT_DISCORD_WEBHOOK is gestuurd.
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz
  /// Gezet met "Afgehandeld" in /admin; daarna staat de melding niet meer in de lijst.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  run        CrawlRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "crawl_alerts_created_idx")
  @@map("crawl_alerts")
}

/// Productpagina's waar de crawler geen product vond (dode pagina, of buiten de categorieën die we
/// van een shop nemen). Ze hebben geen rij in products en dus geen crawl-status; zonder deze tabel
/// staan ze elke ronde weer vooraan in de wachtrij. De crawler slaat ze een week over.
model CrawlMiss {
  shopId    Int      @map("shop_id")
  url       String
  crawledAt DateTime @default(now()) @map("crawled_at") @db.Timestamptz
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, url])
  @@map("crawl_misses")
}

/// Telefoonnummer in de rode balk bovenaan de site (beheerd in het adminpanel).
model PhoneNumber {
  id        Int      @id @default(autoincrement())
  /// Optioneel, bv. "Klantenservice"; staat voor het nummer.
  label     String   @default("")
  /// Zoals getoond, bv. "+31 6 11103563".
  number    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("phone_numbers")
}

/// Social-mediapagina in de footer (beheerd in het adminpanel).
model SocialLink {
  id        Int      @id @default(autoincrement())
  /// Zie SOCIAL_PLATFORMS in src/lib/social-platforms.ts.
  platform  String
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("social_links")
}

/// Betaalde plaatsing (beheerd in het adminpanel): zonder product een uitgelichte webshop, met
/// product een uitgelicht product. Zichtbaar van starts_on tot en met ends_on (Nederlandse
/// datum; ends_on NULL = doorlopend) zolang enabled aanstaat. Kliks hierop krijgen source
/// "featured" in outbound_clicks.
model Promotion {
  id        Int       @id @default(autoincrement())
  shopId    Int       @map("shop_id")
  productId BigInt?   @map("product_id")
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  enabled   Boolean   @default(true)
  /// Alleen voor het adminpanel, bv. adverteerder en afgesproken prijs.
  note      String    @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([startsOn, endsOn], map: "promotions_period_idx")
  @@map("promotions")
}

/// Paginaweergave van een mens (bots gefilterd, zie src/app/api/bezoek/route.ts). Zonder cookies
/// en zonder IP-adres: visitor is een hash van IP + user-agent met het zout van die dag
/// (analytics_salts), dus alleen binnen één dag herkenbaar. Wordt na 400 dagen opgeruimd.
model PageView {
  id        BigInt   @id @default(autoincrement())
  /// Pad zonder taalprefix en zonder query, bv. "/product/123".
  path      String
  lang      String
  /// Host van de verwijzende site (zonder www.) of utm_source/ref, NULL = direct of eigen site.
  referrer  String?
  /// Eerste weergave van een bezoek van buitenaf (nieuwe paginalading, niet vanaf onze eigen site).
  entry     Boolean  @default(false)
  visitor   String
  /// mobile | tablet | desktop
  device    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt], map: "page_views_created_idx")
  @@index([path, createdAt], map: "page_views_path_idx")
  @@map("page_views")
}

/// Willekeurig zout per dag (Nederlandse datum) voor PageView.visitor. Oude zouten worden
/// gewist, zodat hashes van eerdere dagen niet meer terug te rekenen zijn naar een IP-adres.
model AnalyticsSalt {
  day  String @id
  salt String

  @@map("analytics_salts")
}

/// Gebruikersaccount (e-mail + wachtwoord). Inloggen kan pas na het bevestigen van het
/// e-mailadres; daarom horen prijsalarmen en de kortingsmail met hetzelfde adres bij het account.
model User {
  id              BigInt              @id @default(autoincrement())
  /// Altijd in kleine letters opgeslagen.
  email           String              @unique
  /// scrypt, zie src/lib/auth.ts ("scrypt$<salt>$<hash>", base64url).
  passwordHash    String              @map("password_hash")
  /// NULL = nog niet bevestigd; zolang kan er niet worden ingelogd.
  emailVerifiedAt DateTime?           @map("email_verified_at") @db.Timestamptz
  /// Taal van de site bij het registreren; de accountmails gaan in deze taal.
  locale          String              @default("nl")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt     DateTime?           @map("last_login_at") @db.Timestamptz
  sessions        UserSession[]
  tokens          UserToken[]
  watchlist       WatchlistItem[]
  discordWebhooks DiscordSubscriber[]

  @@map("users")
}

/// Inlogsessie. De cookie bevat een willekeurig token; hier staat alleen de SHA-256 ervan.
model UserSession {
  id        String   @id
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_sessions_user_idx")
  @@map("user_sessions")
}

/// Eenmalige link uit een mail: e-mailadres bevestigen, wachtwoord herstellen of een nieuw
/// e-mailadres bevestigen. Net als bij sessies staat alleen de SHA-256 van het token in de database.
model UserToken {
  id        String   @id
  userId    BigInt   @map("user_id")
  /// verify | reset | email
  purpose   String
  /// Bij purpose = email: het nieuwe adres (kleine letters), dat pas na de klik actief wordt.
  newEmail  String?  @map("new_email")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "user_tokens_user_idx")
  @@map("user_tokens")
}

/// Volglijst van een account (zonder account staat die alleen in de browser).
model WatchlistItem {
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("watchlist_items")
}

/// Instellingen voor de hele site (één rij, id 1), beheerd in het adminpanel.
model SiteSetting {
  id                 Int      @id @default(1)
  /// Onderhoudsmodus: bezoekers krijgen een 503-pagina, de admin (cookie) niet.
  maintenance        Boolean  @default(false)
  /// Optioneel, onder de standaardtekst op de onderhoudspagina.
  maintenanceMessage String   @default("") @map("maintenance_message")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_settings")
}
